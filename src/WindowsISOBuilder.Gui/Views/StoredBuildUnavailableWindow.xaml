<Window x:Class="WindowsISOBuilder.Gui.Views.StoredBuildUnavailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="{services:Loc StoredBuildMissingProfileTitle}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,10,0,18" TextWrapping="Wrap"/>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="{services:Loc StoredBuildUseRecommended}" Click="Recommended_Click" Margin="0,0,8,0"/>
            <Button Content="{services:Loc StoredBuildOpenCatalog}" Click="Catalog_Click" Margin="0,0,8,0"/>
            <Button Content="{services:Loc StoredBuildCancel}" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
