<Window x:Class="WindowsISOBuilder.Gui.Views.HistoryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services"
        Title="{services:Loc HistoryDetailsTitle}" Width="700" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{services:Loc HistoryWindows}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Product}" Margin="0,4"/>
                <TextBlock Grid.Row="1" Text="{services:Loc HistoryVersion}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionLabel}" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="{services:Loc HistoryBuild}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Build}" Margin="0,4"/>
                <TextBlock Grid.Row="3" Text="{services:Loc HistoryArchitecture}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ArchitectureLabel}" Margin="0,4"/>
                <TextBlock Grid.Row="4" Text="{services:Loc HistoryLanguage}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Language}" Margin="0,4"/>
                <TextBlock Grid.Row="5" Text="{services:Loc HistoryEditions}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EditionsText}" Margin="0,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="6" Text="{services:Loc HistoryFormat}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ImageFormat}" Margin="0,4"/>
                <TextBlock Grid.Row="7" Text="{services:Loc HistoryOptions}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding OptionsText}" Margin="0,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="8" Text="{services:Loc HistoryStarted}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Started}" Margin="0,4"/>
                <TextBlock Grid.Row="9" Text="{services:Loc HistoryFinished}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Finished}" Margin="0,4"/>
                <TextBlock Grid.Row="10" Text="{services:Loc HistoryStatus}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Status}" Margin="0,4" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="11" Text="{services:Loc HistoryIso}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding IsoDisplay}" Margin="0,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="12" Text="{services:Loc HistorySha256}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Sha256}" IsReadOnly="True" Margin="0,2"/>
                <TextBlock Grid.Row="13" Text="{services:Loc HistoryBuildLog}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding LogDisplay}" Margin="0,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="14" Text="{services:Loc HistoryExecutionLog}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding ExecutionLogDisplay}" Margin="0,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="15" Text="{services:Loc HistoryMetadata}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="15" Grid.Column="1" Text="{Binding MetadataDisplay}" Margin="0,4" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="16" Text="{services:Loc HistoryErrorCode}" Style="{StaticResource FieldLabel}" Margin="0,4"/><TextBlock Grid.Row="16" Grid.Column="1" Text="{Binding ErrorCode}" Margin="0,4"/>
            </Grid>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{services:Loc HistoryOpenFolder}" Click="OpenIsoFolder_Click" IsEnabled="{Binding IsoExists}" Margin="0,0,8,6"/>
            <Button Content="{services:Loc HistoryCopySha}" Click="CopySha_Click" IsEnabled="{Binding HasSha}" Margin="0,0,8,6"/>
            <Button Content="{services:Loc HistoryOpenLog}" Click="OpenLog_Click" IsEnabled="{Binding LogExists}" Margin="0,0,8,6"/>
            <Button Content="{services:Loc HistoryOpenExecutionLog}" Click="OpenExecutionLog_Click" IsEnabled="{Binding ExecutionLogExists}" Margin="0,0,8,6"/>
            <Button Content="{services:Loc HistoryOpenMetadata}" Click="OpenMetadata_Click" IsEnabled="{Binding MetadataExists}" Margin="0,0,8,6"/>
            <Button Content="{services:Loc ProfileCancel}" IsCancel="True" Margin="0,0,0,6"/>
        </WrapPanel>
    </Grid>
</Window>
