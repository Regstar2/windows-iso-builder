<UserControl x:Class="WindowsISOBuilder.Gui.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{services:Loc HelpTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{services:Loc HelpSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{services:Loc HelpBuildTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc HelpBuildStep1}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="{services:Loc HelpBuildStep2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{services:Loc HelpBuildStep3}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{services:Loc HelpBuildStep4}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{services:Loc HelpBuildStep5}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{services:Loc HelpCatalogTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc HelpCatalogDescription}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{services:Loc HelpTroubleshootingTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc HelpTroubleshootingDescription}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
