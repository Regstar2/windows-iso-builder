<Window x:Class="WindowsISOBuilder.Gui.Views.PreflightDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services"
        Title="{services:Loc PreflightDetailsTitle}"
        Width="820" Height="480" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{services:Loc PreflightDetailsTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{services:Loc ColumnStatus}" Binding="{Binding StatusLabel, Mode=OneWay}" Width="110"/>
                <DataGridTextColumn Header="{services:Loc ColumnMessage}" Binding="{Binding Message}" Width="*" MinWidth="280"/>
                <DataGridTextColumn Header="{services:Loc ColumnCode}" Binding="{Binding Code}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="{services:Loc ButtonClose}" IsCancel="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0"/>
    </Grid>
</Window>
