<UserControl x:Class="WindowsISOBuilder.Gui.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services"
             Loaded="OnLoaded">
    <Grid Margin="20,14,20,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{services:Loc ProfilesTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{services:Loc ProfilesSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Row="1" Content="{services:Loc ProfileCreate}" Click="Create_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,9" AutomationProperties.Name="{Binding AccessibilitySummary}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectionModeLabel}" FontWeight="SemiBold" Margin="16,0,0,0"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding BuildHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding Product}"/><Run Text=" · "/><Run Text="{Binding ArchitectureLabel}"/><Run Text=" · "/><Run Text="{Binding Language}"/><Run Text=" · "/><Run Text="{Binding EditionsText}"/><Run Text=" · "/><Run Text="{Binding ImageFormat}"/>
                                </TextBlock>
                                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                    <Button Content="{services:Loc ProfileUse}" Click="Use_Click" Tag="{Binding}" Margin="0,0,8,6" AutomationProperties.Name="{services:Loc AutomationProfilesUse}"/>
                                    <Button Content="{services:Loc ProfileEdit}" Click="Edit_Click" Tag="{Binding}" Margin="0,0,8,6" AutomationProperties.Name="{services:Loc AutomationProfilesEdit}"/>
                                    <Button Content="{services:Loc ProfileDelete}" Click="Delete_Click" Tag="{Binding}" Margin="0,0,8,6" AutomationProperties.Name="{services:Loc AutomationProfilesDelete}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
