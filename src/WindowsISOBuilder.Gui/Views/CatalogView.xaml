<UserControl x:Class="WindowsISOBuilder.Gui.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{services:Loc CatalogTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{services:Loc CatalogSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8,4,0" IsEnabled="{Binding IsConfigurationEnabled}">
            <WrapPanel Orientation="Horizontal">
                <TextBox Width="230" Height="36" Margin="0,0,10,8" VerticalAlignment="Center"
                         Text="{Binding SearchText}" AutomationProperties.Name="{services:Loc AutomationCatalogSearch}"/>
                <ComboBox Width="112" Height="36" Margin="0,0,16,8" VerticalAlignment="Center"
                          SelectedValuePath="Tag" SelectedValue="{Binding Architecture}">
                    <ComboBoxItem Content="x64" Tag="amd64"/>
                    <ComboBoxItem Content="ARM64" Tag="arm64"/>
                    <ComboBoxItem Content="x86" Tag="x86"/>
                    <ComboBoxItem Content="{services:Loc CatalogAll}" Tag="all"/>
                </ComboBox>
                <CheckBox Margin="0,0,16,8" MinHeight="36" VerticalAlignment="Center"
                          Content="{services:Loc CatalogPreview}" IsChecked="{Binding IncludePreview}" ToolTip="{services:Loc TooltipPreview}"/>
                <CheckBox Margin="0,0,16,8" MinHeight="36" VerticalAlignment="Center"
                          Content="{services:Loc CatalogServicing}" IsChecked="{Binding ShowServicing}" ToolTip="{services:Loc TooltipServicing}"/>
                <Button Height="36" Margin="0,0,8,8" VerticalAlignment="Center"
                        Content="{services:Loc ButtonSearch}" Command="{Binding SearchCommand}" MinWidth="88" Padding="16,7"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="CatalogGrid" Grid.Row="2" ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedCatalogBuild, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10" MouseDoubleClick="CatalogGrid_DoubleClick"
                  HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{services:Loc AutomationCatalogGrid}"
                  Background="{DynamicResource WibCardBrush}"
                  Foreground="{DynamicResource WibTextBrush}"
                  RowBackground="{DynamicResource WibCardBrush}"
                  AlternatingRowBackground="{DynamicResource WibSubtleBrush}"
                  AlternationCount="2">
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Background" Value="{DynamicResource WibCardBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource WibSubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WibControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WibControlPressedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="{DynamicResource WibControlBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="5,4"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{services:Loc ColumnVersion}" Binding="{Binding VersionLabel}" Width="120"/>
                <DataGridTextColumn Header="{services:Loc ColumnBuild}" Binding="{Binding Build}" Width="115"/>
                <DataGridTextColumn Header="{services:Loc ColumnArchitecture}" Binding="{Binding Architecture}" Width="105"/>
                <DataGridTextColumn Header="{services:Loc ColumnDate}" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="145"/>
                <DataGridTextColumn Header="{services:Loc ColumnType}" Binding="{Binding EntryType}" Width="105"/>
                <DataGridTextColumn Header="{services:Loc ColumnName}" Binding="{Binding Title}" Width="*" MinWidth="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CatalogSelectionSummary, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="{services:Loc ButtonUseSelected}" Click="UseCatalogBuild_Click" IsEnabled="{Binding CanUseCatalogSelection}"
                        Style="{StaticResource PrimaryButton}" MinWidth="160"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
