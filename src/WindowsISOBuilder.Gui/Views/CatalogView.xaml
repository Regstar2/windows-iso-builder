<UserControl x:Class="WindowsISOBuilder.Gui.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services">
    <Grid Margin="18,14,18,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="{services:Loc CatalogTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{services:Loc CatalogSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" IsEnabled="{Binding IsConfigurationEnabled}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="230"/><ColumnDefinition Width="115"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText}" AutomationProperties.Name="{services:Loc AutomationCatalogSearch}"/>
                <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Architecture}"><ComboBoxItem Content="x64" Tag="amd64"/><ComboBoxItem Content="ARM64" Tag="arm64"/><ComboBoxItem Content="x86" Tag="x86"/><ComboBoxItem Content="{services:Loc CatalogAll}" Tag="all"/></ComboBox>
                <CheckBox Grid.Column="2" Content="{services:Loc CatalogPreview}" IsChecked="{Binding IncludePreview}" ToolTip="{services:Loc TooltipPreview}" Margin="8,0"/>
                <CheckBox Grid.Column="3" Content="{services:Loc CatalogServicing}" IsChecked="{Binding ShowServicing}" ToolTip="{services:Loc TooltipServicing}" Margin="8,0"/>
                <Button Grid.Column="4" Content="{services:Loc ButtonSearch}" Command="{Binding SearchCommand}" MinWidth="80"/>
            </Grid>
        </Border>
        <DataGrid x:Name="CatalogGrid" Grid.Row="2" ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedCatalogBuild, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10" MouseDoubleClick="CatalogGrid_DoubleClick" AutomationProperties.Name="{services:Loc AutomationCatalogGrid}">
            <DataGrid.Columns><DataGridTextColumn Header="{services:Loc ColumnVersion}" Binding="{Binding VersionLabel}"/><DataGridTextColumn Header="{services:Loc ColumnBuild}" Binding="{Binding Build}"/><DataGridTextColumn Header="{services:Loc ColumnArchitecture}" Binding="{Binding Architecture}"/><DataGridTextColumn Header="{services:Loc ColumnDate}" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="145"/><DataGridTextColumn Header="{services:Loc ColumnType}" Binding="{Binding EntryType}"/><DataGridTextColumn Header="{services:Loc ColumnName}" Binding="{Binding Title}" Width="*" MinWidth="220"/></DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CatalogSelectionSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="{services:Loc ButtonUseSelected}" Click="UseCatalogBuild_Click" IsEnabled="{Binding CanUseCatalogSelection}" MinWidth="150"/></Grid></Border>
    </Grid>
</UserControl>
