<UserControl x:Class="WindowsISOBuilder.Gui.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{services:Loc CatalogTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{services:Loc CatalogSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" IsEnabled="{Binding IsConfigurationEnabled}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="230"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="36" VerticalAlignment="Center" Text="{Binding SearchText}" AutomationProperties.Name="{services:Loc AutomationCatalogSearch}"/>
                <ComboBox Grid.Column="2" Height="36" VerticalAlignment="Center" SelectedValuePath="Tag" SelectedValue="{Binding Architecture}">
                    <ComboBoxItem Content="x64" Tag="amd64"/>
                    <ComboBoxItem Content="ARM64" Tag="arm64"/>
                    <ComboBoxItem Content="x86" Tag="x86"/>
                    <ComboBoxItem Content="{services:Loc CatalogAll}" Tag="all"/>
                </ComboBox>
                <CheckBox Grid.Column="4" VerticalAlignment="Center" Content="{services:Loc CatalogPreview}" IsChecked="{Binding IncludePreview}" ToolTip="{services:Loc TooltipPreview}"/>
                <CheckBox Grid.Column="6" VerticalAlignment="Center" Content="{services:Loc CatalogServicing}" IsChecked="{Binding ShowServicing}" ToolTip="{services:Loc TooltipServicing}"/>
                <Button Grid.Column="8" Height="36" VerticalAlignment="Center" Content="{services:Loc ButtonSearch}" Command="{Binding SearchCommand}" MinWidth="88" Padding="16,7"/>
            </Grid>
        </Border>

        <DataGrid x:Name="CatalogGrid" Grid.Row="2" ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedCatalogBuild, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10" MouseDoubleClick="CatalogGrid_DoubleClick"
                  AutomationProperties.Name="{services:Loc AutomationCatalogGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{services:Loc ColumnVersion}" Binding="{Binding VersionLabel}" Width="120"/>
                <DataGridTextColumn Header="{services:Loc ColumnBuild}" Binding="{Binding Build}" Width="115"/>
                <DataGridTextColumn Header="{services:Loc ColumnArchitecture}" Binding="{Binding Architecture}" Width="105"/>
                <DataGridTextColumn Header="{services:Loc ColumnDate}" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="145"/>
                <DataGridTextColumn Header="{services:Loc ColumnType}" Binding="{Binding EntryType}" Width="105"/>
                <DataGridTextColumn Header="{services:Loc ColumnName}" Binding="{Binding Title}" Width="*" MinWidth="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CatalogSelectionSummary, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="{services:Loc ButtonUseSelected}" Click="UseCatalogBuild_Click" IsEnabled="{Binding CanUseCatalogSelection}"
                        Style="{StaticResource PrimaryButton}" MinWidth="160"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
