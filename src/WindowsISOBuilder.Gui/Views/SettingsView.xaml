<UserControl x:Class="WindowsISOBuilder.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{services:Loc SettingsTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{services:Loc SettingsSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="760" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{services:Loc SettingsInterfaceTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Row="1" Text="{services:Loc SettingsLanguageLabel}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                        <ComboBox x:Name="LanguageCombo" Grid.Row="2" Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                  SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Tag="ru" Content="{services:Loc LanguageRussian}"/>
                            <ComboBoxItem Tag="en" Content="{services:Loc LanguageEnglish}"/>
                        </ComboBox>
                        <TextBlock Grid.Row="3" Text="{services:Loc SettingsThemeLabel}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                        <ComboBox x:Name="ThemeCombo" Grid.Row="4" Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Tag="system" Content="{services:Loc ThemeSystem}"/>
                            <ComboBoxItem Tag="light" Content="{services:Loc ThemeLight}"/>
                            <ComboBoxItem Tag="dark" Content="{services:Loc ThemeDark}"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Text="{services:Loc SettingsNetworkTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{services:Loc SettingsNetworkDescription}" TextWrapping="Wrap" Margin="0,8,0,12" MaxWidth="680"/>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{services:Loc NetworkModeLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="NetworkModeCombo" SelectedValuePath="Tag" SelectionChanged="NetworkModeCombo_SelectionChanged"
                                      AutomationProperties.Name="{services:Loc NetworkModeLabel}">
                                <ComboBoxItem Tag="system" Content="{services:Loc NetworkModeSystem}"/>
                                <ComboBoxItem Tag="direct" Content="{services:Loc NetworkModeDirect}"/>
                                <ComboBoxItem Tag="custom" Content="{services:Loc NetworkModeCustom}"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" x:Name="ProxyTypePanel">
                            <TextBlock Text="{services:Loc ProxyTypeLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ProxyTypeCombo" SelectedValuePath="Tag" AutomationProperties.Name="{services:Loc ProxyTypeLabel}">
                                <ComboBoxItem Tag="http" Content="HTTP"/>
                                <ComboBoxItem Tag="socks5" Content="SOCKS5"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" x:Name="ProxyHostPanel" Margin="0,12,0,0">
                            <TextBlock Text="{services:Loc ProxyHostLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <TextBox x:Name="ProxyHostTextBox" AutomationProperties.Name="{services:Loc ProxyHostLabel}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" x:Name="ProxyPortPanel" Margin="0,12,0,0">
                            <TextBlock Text="{services:Loc ProxyPortLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <TextBox x:Name="ProxyPortTextBox" AutomationProperties.Name="{services:Loc ProxyPortLabel}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" x:Name="ProxyUsernamePanel" Margin="0,12,0,0">
                            <TextBlock Text="{services:Loc ProxyUsernameLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <TextBox x:Name="ProxyUsernameTextBox" AutomationProperties.Name="{services:Loc ProxyUsernameLabel}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" x:Name="ProxyPasswordPanel" Margin="0,12,0,0">
                            <TextBlock Text="{services:Loc ProxyPasswordLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="ProxyPasswordBox" AutomationProperties.Name="{services:Loc ProxyPasswordLabel}"/>
                        </StackPanel>

                        <TextBlock x:Name="CredentialStatusText" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource MutedText}"/>

                        <WrapPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,12,0,0">
                            <Button x:Name="SaveNetworkButton" Content="{services:Loc ButtonSaveNetwork}" MinWidth="150" Margin="0,0,8,8"
                                    Click="SaveNetwork_Click" AutomationProperties.Name="{services:Loc ButtonSaveNetwork}"/>
                            <Button x:Name="TestNetworkButton" Content="{services:Loc ButtonTestNetwork}" MinWidth="170" Margin="0,0,8,8"
                                    Click="TestNetwork_Click" AutomationProperties.Name="{services:Loc ButtonTestNetwork}"/>
                            <Button x:Name="ClearCredentialButton" Content="{services:Loc ButtonClearCredential}" MinWidth="190" Margin="0,0,0,8"
                                    Click="ClearCredential_Click" AutomationProperties.Name="{services:Loc ButtonClearCredential}"/>
                        </WrapPanel>
                        <TextBlock x:Name="NetworkStatusText" Grid.Row="7" Grid.ColumnSpan="3" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{services:Loc SettingsUpdatesTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Row="1" Text="{services:Loc SettingsUpdatesDescription}" TextWrapping="Wrap" Margin="0,8,0,12" MaxWidth="680"/>
                        <TextBlock Grid.Row="2" Text="{services:Loc SettingsUpdateChannelLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="UpdateChannelCombo" Grid.Row="3" Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                  SelectionChanged="UpdateChannelCombo_SelectionChanged">
                            <ComboBoxItem Tag="stable" Content="{services:Loc UpdateChannelStable}"/>
                            <ComboBoxItem Tag="prerelease" Content="{services:Loc UpdateChannelPrerelease}"/>
                        </ComboBox>
                        <Button x:Name="CheckUpdatesButton" Grid.Row="4" Content="{services:Loc ButtonCheckUpdates}" HorizontalAlignment="Left" MinWidth="220" Margin="0,12,0,0"
                                Click="CheckUpdates_Click" ToolTip="{services:Loc TooltipCheckUpdates}" AutomationProperties.Name="{services:Loc ButtonCheckUpdates}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="6" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{services:Loc SettingsDiagnosticsTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Row="1" Text="{services:Loc SettingsDiagnosticsDescription}" TextWrapping="Wrap" Margin="0,8,0,12" MaxWidth="680"/>
                        <Button Grid.Row="2" Content="{services:Loc ButtonCreateDiagnostics}" HorizontalAlignment="Left" MinWidth="220"
                                Click="CreateDiagnostics_Click" ToolTip="{services:Loc TooltipDiagnostics}"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
