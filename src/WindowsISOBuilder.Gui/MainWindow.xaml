<Window x:Class="WindowsISOBuilder.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows ISO Builder"
        Width="1100" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="Windows ISO Builder" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Version}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#EEEEEE">
            <StackPanel Margin="12">
                <Button Content="Быстрый" Click="Quick_Click" HorizontalContentAlignment="Left"/>
                <Button Content="Каталог" Click="Catalog_Click" HorizontalContentAlignment="Left"/>
                <Separator Margin="4,12"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="8"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Grid.Column="1" BorderThickness="0" Background="Transparent">
            <TabItem Header="Быстрый">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="780">
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConfigurationEnabled}">
                            <StackPanel>
                                <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <ComboBox Width="180" SelectedValuePath="Content" SelectedValue="{Binding Product}">
                                        <ComboBoxItem Content="Windows 11"/>
                                        <ComboBoxItem Content="Windows 10"/>
                                    </ComboBox>
                                    <ComboBox Width="120" SelectedValuePath="Tag" SelectedValue="{Binding Architecture}">
                                        <ComboBoxItem Content="x64" Tag="amd64"/>
                                        <ComboBoxItem Content="ARM64" Tag="arm64"/>
                                        <ComboBoxItem Content="x86" Tag="x86"/>
                                    </ComboBox>
                                    <Button Content="Получить рекомендуемую" Command="{Binding LoadRecommendedCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="Рекомендуемая версия" Foreground="#666" Margin="4,10,4,0"/>
                                <TextBlock Text="{Binding SelectedBuild.Title}" FontWeight="SemiBold" FontSize="16" Margin="4" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedBuildSummary}" Foreground="#666" Margin="4"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConfigurationEnabled}">
                            <StackPanel>
                                <TextBlock Text="Параметры" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Язык" Margin="0,8,0,0"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
                                <TextBlock Text="Редакции" Margin="0,10,0,2"/>
                                <ItemsControl ItemsSource="{Binding Editions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Формат образа" Margin="0,10,0,2"/>
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding ImageFormat}" Width="120" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="ESD"/>
                                    <ComboBoxItem Content="WIM"/>
                                </ComboBox>
                                <TextBlock Text="ESD — меньше размер; WIM — удобнее для обслуживания." Foreground="#666" TextWrapping="Wrap"/>
                                <Expander Header="Дополнительные параметры" Margin="0,10">
                                    <StackPanel Margin="8,4">
                                        <CheckBox Content="Интегрировать обновления" IsChecked="{Binding AddUpdates}"/>
                                        <CheckBox Content="Очистить компоненты после интеграции" IsChecked="{Binding Cleanup}"/>
                                        <CheckBox Content="Добавить .NET Framework 3.5" IsChecked="{Binding NetFx3}"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Каталог для ISO"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Выбрать" Click="Browse_Click"/>
                                    <TextBox Text="{Binding OutputDirectory}"/>
                                </DockPanel>
                                <Button Content="Проверить готовность" Command="{Binding PreflightCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsConfigurationEnabled}">
                            <StackPanel>
                                <TextBlock Text="Проверка готовности" FontSize="18" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Code}" Foreground="#777" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Проверить снова" Command="{Binding PreflightCommand}"/>
                                    <Button Content="Создать ISO" Command="{Binding BuildCommand}" IsEnabled="{Binding CanBuild}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsBuilding, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Сборка" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Stage}" Foreground="#666"/>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="18" Minimum="0" Maximum="100" Margin="0,8"/>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Speed}"/>
                                <Button Content="Отменить" Command="{Binding CancelCommand}" HorizontalAlignment="Left"/>
                                <Expander Header="Технические подробности" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding ActiveBuildRequestId}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ErrorTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#A4262C" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ErrorExplanation}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Повторить" Command="{Binding RetryCommand}"/>
                                    <Button Content="Открыть журнал" IsEnabled="{Binding HasErrorLog}" Click="OpenErrorLog_Click"/>
                                    <Button Content="Скопировать диагностику" Click="CopyDiagnostics_Click"/>
                                </WrapPanel>
                                <Expander Header="Технические подробности" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsCancelled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Сборка отменена" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Частично загруженные данные сохранены backend и могут быть использованы при следующей сборке." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Button Content="Создать другой ISO" Click="StartOver_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="ISO готов" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Result.IsoPath}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="SHA-256" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Result.Sha256}" TextWrapping="Wrap" FontFamily="Consolas"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Открыть папку" Click="OpenResultFolder_Click"/>
                                    <Button Content="Открыть журнал" IsEnabled="{Binding HasResultLog}" Click="OpenResultLog_Click"/>
                                    <Button Content="Копировать SHA-256" Click="CopySha_Click"/>
                                    <Button Content="Создать другой ISO" Click="StartOver_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Каталог" IsEnabled="{Binding IsConfigurationEnabled}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Каталог Windows" FontSize="22" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBox Text="{Binding SearchText}" MinWidth="300"/>
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Architecture}" Width="120">
                                <ComboBoxItem Content="x64" Tag="amd64"/>
                                <ComboBoxItem Content="ARM64" Tag="arm64"/>
                                <ComboBoxItem Content="x86" Tag="x86"/>
                                <ComboBoxItem Content="Все" Tag="all"/>
                            </ComboBox>
                            <CheckBox Content="Показывать Preview" IsChecked="{Binding IncludePreview}" VerticalAlignment="Center" Margin="8,0"/>
                            <CheckBox Content="Показывать служебные записи" IsChecked="{Binding ShowServicing}" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Content="Найти" Command="{Binding SearchCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="CatalogGrid" Grid.Row="1" ItemsSource="{Binding Builds}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0" MouseDoubleClick="CatalogGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Версия" Binding="{Binding VersionLabel}"/>
                            <DataGridTextColumn Header="Сборка" Binding="{Binding Build}"/>
                            <DataGridTextColumn Header="Архитектура" Binding="{Binding Architecture}"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding EntryType}"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Использовать выбранную" Click="UseCatalogBuild_Click"/>
                        <TextBlock Text="Выберите сборку и нажмите кнопку или дважды щёлкните строку, чтобы открыть её параметры." Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock Text="UUP dump / Microsoft CDN" Margin="20,0" VerticalAlignment="Center" Foreground="#666"/>
        </Border>
    </Grid>
</Window>
