<Window x:Class="WindowsISOBuilder.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WindowsISOBuilder.Gui.Services"
        xmlns:views="clr-namespace:WindowsISOBuilder.Gui.Views"
        Title="{services:Loc AppTitle}"
        Width="1100" Height="700" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Continue">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <TextBlock Text="{services:Loc AppTitle}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Version}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.72"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,1,0">
            <Grid Margin="4,12,4,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button Grid.Row="0" Content="{services:Loc NavQuick}" Style="{StaticResource SidebarButton}" Click="Quick_Click"
                        AutomationProperties.Name="{services:Loc AutomationNavQuick}"/>
                <Button Grid.Row="1" Content="{services:Loc NavCatalog}" Style="{StaticResource SidebarButton}" Click="Catalog_Click"
                        AutomationProperties.Name="{services:Loc AutomationNavCatalog}"/>
                <Separator Grid.Row="2" Margin="10,10"/>
                <StackPanel Grid.Row="3" Margin="12,4">
                    <TextBlock Text="{services:Loc SidebarState}" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Grid.Column="1" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue">
            <TabControl.Template><ControlTemplate TargetType="{x:Type TabControl}"><ContentPresenter Content="{TemplateBinding SelectedContent}"/></ControlTemplate></TabControl.Template>
            <TabItem Focusable="False" IsTabStop="False"><views:QuickView/></TabItem>
            <TabItem Focusable="False" IsTabStop="False"><views:CatalogView BuildActivated="CatalogView_BuildActivated"/></TabItem>
        </TabControl>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{services:Loc FooterSource}" VerticalAlignment="Center" Opacity="0.72"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{services:Loc FooterLanguage}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="UiLanguageCombo" Width="112" Height="28" Margin="0" SelectedValuePath="Tag"
                              SelectionChanged="UiLanguage_SelectionChanged" AutomationProperties.Name="{services:Loc AutomationUiLanguage}">
                        <ComboBoxItem Tag="ru" Content="{services:Loc LanguageRussian}"/><ComboBoxItem Tag="en" Content="{services:Loc LanguageEnglish}"/>
                    </ComboBox>
                    <Button Content="{services:Loc FooterDiagnostics}" Style="{StaticResource FooterButton}" Click="CreateDiagnostics_Click"
                            ToolTip="{services:Loc TooltipDiagnostics}" AutomationProperties.Name="{services:Loc AutomationDiagnostics}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
