<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WibPageBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="WibSurfaceBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="WibCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WibSubtleBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="WibBorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="WibTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="WibMutedTextBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="WibControlBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WibDisabledControlBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="WibDisabledTextBrush" Color="#6F6F6F"/>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WibPageBackgroundBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WibControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource WibDisabledTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource WibDisabledControlBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WibControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource WibDisabledTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource WibDisabledControlBrush}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WibControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource WibDisabledTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource WibDisabledControlBrush}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WibControlBrush}"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,2,14,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource WibDisabledTextBrush}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource WibSubtleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource WibCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="StatusBanner" TargetType="Border">
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="{DynamicResource WibSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WibMutedTextBrush}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
    </Style>

    <Style x:Key="GuidedActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GuidedStepBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="-4,-2,0,-2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Background" Value="{DynamicResource WibSubtleBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavigationRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavigationSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavigationSurface" Property="Background" Value="{DynamicResource WibSubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavigationSurface" Property="Background" Value="{DynamicResource WibCardBrush}"/>
                            <Setter TargetName="NavigationSurface" Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource WibCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource WibTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WibBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource WibBorderBrush}"/>
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
</ResourceDictionary>
